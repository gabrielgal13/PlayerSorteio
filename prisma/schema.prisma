generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}
datasource db {
  provider = "postgresql"
}

model Streamer {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  mascot       String  @default("careca")
  displayName  String?
  nome         String?  // Nome real para identificação (ex: Felipe Paiva)
  isAdmin      Boolean  @default(false)

  // Canais
  twitchChannel  String?
  kickChannel    String?
  // OAuth do streamer (não do bot) — usado pra ler a lista de inscritos do canal.
  // Só disponível pra quem é Afiliado/Parceiro Twitch de verdade (setado manualmente pelo admin).
  twitchAffiliateEnabled Boolean @default(false)
  twitchUserId           String?
  twitchUserAccessToken  String?
  twitchUserRefreshToken String?
  kickChatroomId Int?
  youtubeChannel     String?
  youtubeDisplayName String?

  // YouTube live chat polling (server-side)
  youtubeLiveChatId       String?
  youtubeNextPageToken    String?
  youtubeLiveChatCheckedAt DateTime?

  // TwitchConfig (editável pelo modal de Configurações)
  registrationCommand String @default("!entrar")
  claimCommand        String @default("!claim")
  validationTimeout   Int    @default(60)

  // Afiliado (controla visibilidade do PSC)
  isAffiliate Boolean @default(true)

  // Perfil de teste — o streamer usa o sistema normalmente, mas os sorteios
  // dele ficam fora das visões oficiais do admin (aba Entregas e afins).
  testProfile Boolean @default(false)

  // Saldo PSC
  pscBalance Int @default(0)

  // Preferências
  audioEnabled              Boolean @default(true)
  excelImportEnabled        Boolean @default(true)
  excelPrizesImportEnabled  Boolean @default(true)
  eventMusic          String  @default("cyberpunk")
  eventEffect         String  @default("confetti")
  spinEffect              String  @default("numbers")
  themeColor              String  @default("#00E5FF")
  socoChuteModeEnabled    Boolean @default(true)
  raffleTriggerMode       String  @default("manual")
  autoRoundDelay          Int     @default(30)
  chatTriggerCount        Int     @default(50)
  chatTriggerCommand      String  @default("!sortear")
  raffleAnimationStyle    String  @default("balada")

  // Chat Wars — sprite neutro (data URL base64) usado como base das bolinhas
  chatWarsSprite String?
  // Chat Wars — sprite do LIVE BOSS (data URL base64). Sem isso, cai no sprite neutro.
  chatWarsBossSprite String?

  // Rank da Comunidade — cache calculado a partir de RankEvent (fonte da verdade)
  rankPoints         Int       @default(0)
  rankStreakCount     Int       @default(0)
  rankLastActiveDate  DateTime?
  rankLastRaffleAt    DateTime?

  history         RaffleHistory[]
  pscTransactions PscTransaction[]
  prizeLists      PrizeList[]
  botCommands     BotCommand[]
  rankEvents      RankEvent[]

  forcePasswordChange Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RankEvent {
  id         String   @id @default(cuid())
  streamer   Streamer @relation(fields: [streamerId], references: [id])
  streamerId String
  type       String   // 'sorteio' | 'jogo_concluido' | 'streak_bonus'
  points     Int
  createdAt  DateTime @default(now())

  @@index([streamerId, type, createdAt])
}

model PrizeList {
  id          String          @id @default(cuid())
  streamer    Streamer        @relation(fields: [streamerId], references: [id])
  streamerId  String
  name        String
  description String?
  visibility  String          @default("public")
  coverUrl    String?
  items       PrizeListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrizeListItem {
  id          String    @id @default(cuid())
  prizeList   PrizeList @relation(fields: [prizeListId], references: [id], onDelete: Cascade)
  prizeListId String
  name        String
  description String?
  imageUrl    String?
  quantity    Int       @default(1)
  pscValue    Int?
  skipPsc     Boolean   @default(false)
  order       Int       @default(0)
}

model PscTransaction {
  id          String   @id @default(cuid())
  streamer    Streamer @relation(fields: [streamerId], references: [id])
  streamerId  String
  type        String   @default("credit")
  amount      Int
  description String   @default("Recarga PSC")
  timestamp   DateTime @default(now())
}

model MarketingImage {
  id        Int      @id @default(autoincrement())
  imageData String   // base64 data URL
  label     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AffiliateProposal {
  id               String   @id @default(cuid())
  streamerName     String
  coupon           String?
  profitPct        Float
  status           String   @default("pending") // pending | accepted | refused
  accountConfirmed Boolean  @default(false)
  shirtsConfirmed  Boolean  @default(false)
  startedAt        DateTime? // Dia inicial da afiliação (definido pelo botão "Iniciar")
  contractMonths   Int?      // Duração do contrato em meses (definido na criação da proposta)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Sale {
  id                    String   @id @default(cuid())
  orderNumber           String   // Número do pedido
  date                  String
  contactName           String
  cpfCnpj               String
  email                 String?
  city                  String?
  state                 String?
  productDescription   String
  quantity              Int
  unitPrice             Float
  totalPrice            Float
  discount              Float   @default(0)
  shipping              Float   @default(0)
  status                String  @default("Em aberto") // Em aberto, Finalizado, Despesa Afiliado
  affiliateUsername     String?  // Username do streamer afiliado (quando status = Despesa Afiliado)
  trackingCode          String?
  observations          String?
  source                String?  // Origem do lançamento manual: 'vendas' | 'playerskins' (null = venda do CSV)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([orderNumber, productDescription]) // Chave única composta: pedido + produto
}

model RaffleHistory {
  id         String   @id @default(cuid())
  streamer   Streamer @relation(fields: [streamerId], references: [id])
  streamerId String

  // Ganhador
  winnerNumber Int
  winnerName   String
  winnerSource String?

  // Prêmio
  prizeName        String
  prizeDescription String?
  prizeImageUrl    String?
  prizeQuantity    Int
  prizePscValue    Int?

  confirmed Boolean  @default(false)
  timestamp DateTime @default(now())

  tradeLink      String?
  deliveryStatus String  @default("novo")
  tradeLockAt    DateTime?

  // Marketplace (Waxpeer)
  marketplaceItemId    String?
  marketplaceRetries   Int       @default(0)
  marketplaceCheckedAt DateTime?
}

model BotCommand {
  id         String   @id @default(cuid())
  streamer   Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  streamerId String
  command    String
  response   String
  createdAt  DateTime @default(now())
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
